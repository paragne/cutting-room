# Base URL of the Immich server, reachable from this app's server.
IMMICH_URL=http://immich.example.internal:2283
# Immich API key. Placeholder only, never commit a real key.
IMMICH_API_KEY=replace-with-immich-api-key
# Argon2id hash of the app password, base64-encoded. Generate with:
#   read -rs P && printf %s "$P" | node scripts/hash-password.ts; unset P
APP_PASSWORD_HASH=replace-with-hash-password-output
# Directory for the SQLite database. Defaults to ./data.
DATA_DIR=data
# Public URL the app is served at. Used for the Origin check.
ORIGIN=https://cutting-room.example.com
# Production only (read by adapter-node, ignored by `npm run dev`). Without these the
# login rate limit sees the reverse proxy's IP for every client. XFF_DEPTH is the
# number of trusted proxies in front of the app.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
